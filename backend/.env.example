# Copy this file to `.env` and fill in your values. NEVER commit the real .env.

# Google Safe Browsing API key (server-side only; never sent to the frontend).
# Get one at: https://console.cloud.google.com/ (enable "Safe Browsing API").
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional tuning (defaults shown).
GSB_TIMEOUT_SECONDS=5
GSB_CLIENT_ID=linkshield-ai
GSB_CLIENT_VERSION=0.3.0
