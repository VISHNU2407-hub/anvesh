# Frontend configuration — copy to .env and adjust.
# VITE_USE_MOCK=true  -> local demo data (no backend needed)
# VITE_USE_MOCK=false -> live backend at VITE_API_BASE_URL
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://127.0.0.1:8000
# To use the live backend locally: set VITE_USE_MOCK=false and keep the default
# VITE_API_BASE_URL, then run `uvicorn app.main:app --reload` in backend/.
