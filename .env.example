# Frontend configuration — copy to .env and adjust.
# VITE_USE_MOCK=false -> live backend at VITE_API_BASE_URL (intended)
# VITE_USE_MOCK=true  -> local demo data (no backend needed)
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://127.0.0.1:8000
# To use demo locally: set VITE_USE_MOCK=true
# To use the live backend locally: keep VITE_USE_MOCK=false and run `uvicorn app.main:app --reload` in backend/.
